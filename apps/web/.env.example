# Copy to .env.local and fill in. Never commit real values.

# OpenAI, server only. The key stays on the server and is never sent to the browser.
OPENAI_API_KEY=
# The vision-capable model to use, for example one listed on https://platform.openai.com/docs/models
OPENAI_MODEL=
# Prices of that model in USD per million tokens, from https://openai.com/api/pricing
OPENAI_PRICE_INPUT_PER_MTOK=
OPENAI_PRICE_CACHED_INPUT_PER_MTOK=
OPENAI_PRICE_OUTPUT_PER_MTOK=
OPENAI_MAX_OUTPUT_TOKENS=16000
OPENAI_TIMEOUT_MS=50000

# Upstash Redis: usage limits and the monthly spend counter. Required in production.
# Without them, local development keeps limits in memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random string used to hash visitor IPs (at least 16 characters). Required in production.
IP_HASH_SALT=

# Limits
MONTHLY_BUDGET_USD=18
DAILY_GENERATIONS_PER_VISITOR=5
GENERATIONS_PER_MINUTE=3

# Origin of the preview sandbox (apps/preview).
NEXT_PUBLIC_PREVIEW_ORIGIN=http://localhost:4100
