# Copy to .env.local. Never commit real values.

# OpenAI (phase 8). Server only.
OPENAI_API_KEY=
OPENAI_MODEL=

# Upstash Redis: usage limits and monthly budget counter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random string used to hash visitor IPs (at least 16 characters).
IP_HASH_SALT=

# Limits
MONTHLY_BUDGET_USD=18
DAILY_GENERATIONS_PER_VISITOR=5

# Origin of the preview sandbox (apps/preview).
NEXT_PUBLIC_PREVIEW_ORIGIN=http://localhost:4100
